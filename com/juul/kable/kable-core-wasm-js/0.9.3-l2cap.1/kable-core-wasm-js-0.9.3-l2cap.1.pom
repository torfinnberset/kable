    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/JuulLabs/kable.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/JuulLabs/kable.git</developerConnection>
    <url>https://github.com/JuulLabs/kable</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jetbrains.kotlin-wrappers</groupId>
        <artifactId>kotlin-wrappers-bom</artifactId>
